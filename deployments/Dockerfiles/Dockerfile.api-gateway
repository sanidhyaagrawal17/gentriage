FROM golang:1.23-alpine AS builder

WORKDIR /app
COPY go-services/go.mod ./
# Fetch dependencies (ensure mongo driver and others are available during build)
RUN go get go.mongodb.org/mongo-driver@latest || true
RUN go mod tidy

COPY go-services/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /api-gateway ./cmd/api-gateway

FROM alpine:latest
WORKDIR /app
COPY --from=builder /api-gateway /api-gateway
RUN mkdir -p /data/apks
EXPOSE 8080
ENTRYPOINT ["/api-gateway"]
